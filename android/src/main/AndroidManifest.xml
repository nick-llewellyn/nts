<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Minimum manifest stub required by the Android Gradle Plugin for
        a `com.android.library` module. The `nts` plugin itself contributes
        no components, permissions, or queries to the host application; the
        runtime contract is purely a `FlutterPlugin` (`NtsPlugin`) loaded
        by `GeneratedPluginRegistrant` and a JNI Kotlin counterpart
        (`PlatformInit`) referenced from `rust/src/android_init.rs`.

        The `INTERNET` permission required for NTS-KE (TCP/4460) and NTPv4
        (UDP/123) is not declared here: it belongs in the host
        application's manifest, which is also where users see and audit
        it. The companion `rustls-platform-verifier` AAR's own manifest
        does merge it into the host app, together with an
        `android:networkSecurityConfig` that permits cleartext HTTP to the
        CRL distribution hosts upstream lists (see the `dependencies`
        block in `build.gradle.kts`).
    -->
</manifest>
